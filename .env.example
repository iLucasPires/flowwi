# Copie este arquivo para .env e ajuste os valores.
# `docker compose up` já funciona com os valores padrão abaixo (login social e
# IA ficam desativados até você preencher chaves reais).

# -----------------------------------------------------------------------------
# Django
# -----------------------------------------------------------------------------
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,api
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:5173
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# -----------------------------------------------------------------------------
# Postgres
# -----------------------------------------------------------------------------
POSTGRES_DB=flowwi
POSTGRES_USER=flowwi
POSTGRES_PASSWORD=flowwi
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# -----------------------------------------------------------------------------
# Redis
# -----------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# -----------------------------------------------------------------------------
# Email (Mailpit em dev — captura tudo em http://localhost:8025)
# -----------------------------------------------------------------------------
EMAIL_PORT=1025
EMAIL_HOST=mailpit
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@flowwi.local

# -----------------------------------------------------------------------------
# OAuth — Google (login social + Google Drive) e GitHub
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET_KEY=
GOOGLE_AI_API_KEY=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET_KEY=

# -----------------------------------------------------------------------------
# Unsplash (seletor de capas — opcional)
# -----------------------------------------------------------------------------
UNSPLASH_ID=
UNSPLASH_ACCESS_KEY=
UNSPLASH_SECRET_KEY=

# -----------------------------------------------------------------------------
# S3 (usado apenas quando DJANGO_DEBUG=False)
# -----------------------------------------------------------------------------
AWS_ACCESS_KEY_ID=
AWS_ENDPOINT_URL=
AWS_S3_REGION_NAME=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=

# -----------------------------------------------------------------------------
# Frontend (Vite)
# -----------------------------------------------------------------------------
VITE_API_URL=http://api:8000

# -----------------------------------------------------------------------------
# pgAdmin (perfil "tools")
# -----------------------------------------------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@flowwi.local
PGADMIN_DEFAULT_PASSWORD=admin
